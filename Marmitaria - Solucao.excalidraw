    {
      "id": "qD2yulwE7tKpMlj-7c5N1",
      "type": "text",
      "x": 933.5,
      "y": 1458.75,
      "width": 583.11962890625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
