      "index": "as",
      "roundness": null,
      "seed": 22193665,
      "version": 1374,
      "versionNonce": 549626306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769795911435,
      "link": null,
      "locked": false,
      "text": "RF01 - O sistema deve cadastrar clientes;\nRF02 - O sistema deve cadastrar produtos;\nRF03 - O sistema deve emitir pedidos;\nRF04 - O sistema deve deletar pedidos;\nRF05 - O sistema deve cadastrar opções de entrega;\nRF06 - O sistema deve imprimir resumo do Pedido;\nRF07 - O sistema deve receber meios de pagamento eletrônico;\nRF08 - O sistema deve gerar relatório de controle de vendas;\nRF09 - O sistema deve gerar relatório de controle de entregas;\nRF10 - O sistema deve gerar relatório de controle de estoque;\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RF01 - O sistema deve cadastrar clientes;\nRF02 - O sistema deve cadastrar produtos;\nRF03 - O sistema deve emitir pedidos;\nRF04 - O sistema deve deletar pedidos;\nRF05 - O sistema deve cadastrar opções de entrega;\nRF06 - O sistema deve imprimir resumo do Pedido;\nRF07 - O sistema deve receber meios de pagamento eletrônico;\nRF08 - O sistema deve gerar relatório de controle de vendas;\nRF09 - O sistema deve gerar relatório de controle de entregas;\nRF10 - O sistema deve gerar relatório de controle de estoque;\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
