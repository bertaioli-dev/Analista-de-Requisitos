      "isDeleted": false,
      "boundElements": null,
      "updated": 1769696126009,
      "link": null,
      "locked": false,
      "text": "=> Resumo do Pedido:\n    - O sistema precisa emitir um resumo do pedido, indicando os itens,\n    forma de pagamento e entrega programada;\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "=> Resumo do Pedido:\n    - O sistema precisa emitir um resumo do pedido, indicando os itens,\n    forma de pagamento e entrega programada;\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Bc26v566qr_btsJ0gcnzl",
      "type": "text",
      "x": 1663.178571428571,
      "y": 1124.392857142857,
      "width": 744.5995483398438,
      "height": 175,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
